{
  "name": "archlab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch beckend/server.js",
    "build": "node scripts/clean-build.mjs && vite build && node scripts/prepare-sites.mjs",
    "lint": "eslint .",
    "start": "node beckend/server.js",
    "seed:owner": "node beckend/seedOwner.js",
    "preview": "vite preview",
    "test:api": "node --test tests/api.test.mjs",
    "test:integration": "node tests/run-integration.mjs",
    "storage:worker": "node beckend/storage/worker.js",
    "test:storage": "node tests/run-integration.mjs --storage-only",
    "test:analytics": "node tests/run-integration.mjs --analytics-only"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@material-tailwind/react": "2.1.10",
    "animejs": "4.5.0",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.5.0",
    "multer": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.8.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@material-tailwind/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
